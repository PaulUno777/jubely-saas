# Go API origin (no /api suffix). Browser calls use Next BFF at /api/v1/* on port 3000.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8082

# Server-side BFF → Go (copy to .env.local)
API_INTERNAL_BASE_URL=http://localhost:8082

# Local HTTP dev: cookies must not be Secure-only (default is secure only in production)
# COOKIE_SECURE=false
