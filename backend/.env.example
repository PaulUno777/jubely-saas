# Listen port inside the API process (8080 in Docker; compose maps host 8082→8080)
HTTP_PORT=8080
DATABASE_URL=postgresql://jubely:jubely@localhost:5432/jubely

# Tools on the host (pnpm dev:seed, browser) — must match docker-compose publish port, not HTTP_PORT
# API_PUBLIC_BASE=http://localhost:8082

# Allow cors from all origins
CORS_ALLOW_ALL=true

# Min 32 chars
JWT_SECRET=change-me-please-change-me-32chars!!
JWT_ACCESS_TTL_MINUTES=60

# One-time superadmin bootstrap
BOOTSTRAP_SECRET=change-me-bootstrap-secret-32chars!!

# Optional: separate secret for QR display tokens (defaults to JWT_SECRET if unset)
# QR_TOKEN_SECRET=change-me-please-change-me-32chars!!

# File uploads (tenant logos)
# local: store on disk and serve via /v1/public/files/*
FILE_STORAGE_DRIVER=local
ASSET_UPLOAD_DIR=/absolute/path/to/backend/.uploads
PUBLIC_FILE_BASE_URL=http://localhost:8082/v1/public/files

# Optional: log OTP codes in API logs
PUBLIC_OTP_LOG_CODE=true
# When set (e.g. 000000), OTP send always uses this code — for scripts/dev-seed.mjs only.
PUBLIC_OTP_DEV_CODE=000000

# Billing (optional — MoMo reference works without Stripe)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_GROWTH=price_...
# STRIPE_PRICE_BUSINESS=price_...
